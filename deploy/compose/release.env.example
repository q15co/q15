# Informational source revision of the atomic stack release.
Q15_RELEASE_REVISION=<full-git-sha>

# Resolve these exact multi-platform digests from the release manifest. Do not
# substitute moving tags such as main or release-main here.
Q15_AGENT_IMAGE=ghcr.io/q15co/q15-agent@sha256:<manifest-digest>
Q15_EXEC_IMAGE=ghcr.io/q15co/q15-exec@sha256:<manifest-digest>
Q15_PROXY_IMAGE=ghcr.io/q15co/q15-proxy@sha256:<manifest-digest>
