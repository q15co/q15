# Use stable for normal updates. For a pinned deployment or rollback, replace
# it with one immutable DateVer published on all three q15 packages, such as
# 2026.09.05.164.
Q15_IMAGE_TAG=stable

# Optional: override the pod-local Ollama embeddings backend (see the Compose stacks).
# OLLAMA_IMAGE=ollama/ollama:0.40.6
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Deprecated: override the TEI embeddings backend (only for deployments that have
# not migrated to q15-ollama yet; removed one release after the install profile ships).
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.9
# TEI_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional: the stack's timezone. It reaches prompt-visible timestamps and shell tools in
# the containers, and it defaults to UTC.
# TZ=Europe/Berlin
